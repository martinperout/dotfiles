# vim to nvim
alias vim='nvim'
alias vi='nvim'

# top to btop
alias top='btop'

# command aliases
alias cp='cp -i'
alias mv='mv -i'
alias rm='trash -v'
alias mkdir='mkdir -p'
alias ping='ping -c 10'
alias less='less -R'
alias dnf='sudo dnf'

# cd aliases
alias home='cd ~'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# ls aliases
alias ls='ls --color=always'
alias la='ls -la'